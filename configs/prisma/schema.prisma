// https://supabase.com/partners/integrations/prisma

// NOTE: 
// I do not use database of Supabase, I use my own database with prisma to save data locally.
// I only use Supabase for authentication (Google, GitHub, Discord login).
// Supabase Storage is used for file uploads (avatars, images, etc.)

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                          ENUMS                              ║
// ╚══════════════════════════════════════════════════════════════╝

/// Vai trò trên web - quyền hạn hệ thống
/// ADMIN: Toàn quyền quản trị
/// COLLABORATOR: Cộng tác viên - được đăng bài, quản lý sự kiện
/// MEMBER: Thành viên - tự sửa thông tin cá nhân, viết blog chờ duyệt
/// GUEST: Đăng nhập bình thường, chưa được xác nhận thành viên
enum WebRole {
  ADMIN
  COLLABORATOR
  MEMBER
  GUEST

  @@schema("public")
}

/// Chức vụ trong CLB
/// Phản ánh cơ cấu tổ chức: Chủ nhiệm > Phó CN > Trưởng ban > Phó ban > Thành viên ban
/// Ngoài ra còn: Cộng tác viên, Giảng viên cố vấn
enum ClubPosition {
  PRESIDENT // Chủ nhiệm CLB
  VICE_PRESIDENT // Phó chủ nhiệm CLB
  DEPARTMENT_LEADER // Trưởng ban
  DEPARTMENT_VICE_LEADER // Phó ban
  DEPARTMENT_MEMBER // Thành viên ban
  COLLABORATOR // Cộng tác viên
  ADVISOR // Giảng viên cố vấn

  @@schema("public")
}

/// Trạng thái bài viết - workflow duyệt bài
/// Blog: DRAFT -> PENDING_REVIEW -> PUBLISHED (hoặc REJECTED)
/// Event/Achievement (chỉ ADMIN/COLLABORATOR tạo): DRAFT -> PUBLISHED (không cần duyệt)
enum PostStatus {
  DRAFT // Bản nháp - chưa gửi duyệt
  PENDING_REVIEW // Đang chờ duyệt
  PUBLISHED // Đã xuất bản
  UNLISTED // Đã xuất bản nhưng không hiển thị trong danh sách (chỉ xem được qua link trực tiếp)
  ARCHIVED // Đã lưu trữ
  REJECTED // Bị từ chối

  @@schema("public")
}

/// Phân loại bài viết (gom Post, Event, Achievement cũ)
enum PostType {
  BLOG // Bài viết chia sẻ thông thường (không phân loại)
  EVENT // Bài viết về sự kiện CLB
  ACHIEVEMENT // Bài viết tuyên dương thành tựu

  @@schema("public")
}

/// Ngôn ngữ gốc khi soạn thảo bài viết (dùng để biết bản nào là gốc, bản nào cần dịch)
enum PostLanguage {
  VI // Tiếng Việt
  EN // Tiếng Anh

  @@schema("public")
}

/// Trạng thái sự kiện (dành cho Post type=EVENT)
enum EventStatus {
  UPCOMING // Sắp diễn ra
  ONGOING // Đang diễn ra
  COMPLETED // Đã hoàn thành
  CANCELLED // Đã hủy

  @@schema("public")
}

/// Loại thành tựu (dành cho Post type=ACHIEVEMENT)
enum AchievementType {
  INDIVIDUAL // Cá nhân (Olympic, thi đấu)
  TEAM // Nhóm dự án
  CLUB // Toàn CLB (CLB xuất sắc)

  @@schema("public")
}

/// Phân loại sự kiện (dành cho Post type=EVENT)
enum EventType {
  ACADEMIC // Tổ chức cuộc thi học thuật
  MEMBER_ACTIVITY // Hoạt động thành viên
  VOLUNTEER // Hoạt động tình nguyện
  SEMINAR // Hội thảo / Seminar
  OTHER // Khác

  @@schema("public")
}

/// Loại thông báo
enum NotificationType {
  POST_APPROVED // Bài viết của bạn đã được duyệt
  POST_REJECTED // Bài viết của bạn bị từ chối
  POST_PUBLISHED // Có bài viết mới được đăng
  EVENT_UPCOMING // Sắp có sự kiện mới
  ACHIEVEMENT_NEW // Có thành tựu mới được công bố
  ROLE_UPDATED // Vai trò trong CLB của bạn đã được cập nhật
  MEMBER_WELCOME // Chào mừng thành viên mới
  SYSTEM // Thông báo hệ thống

  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                     SITE SETTINGS                           ║
// ╚══════════════════════════════════════════════════════════════╝

/// Cài đặt trang web - Lưu cấu hình chung dạng key-value
model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

/// Thông báo hiển thị trên AnnouncementBar
model Announcement {
  id          String    @id @default(cuid())
  contentVi   String
  contentEn   String
  linkUrl     String?
  linkLabelVi String?
  linkLabelEn String?
  bgColor     String?
  isActive    Boolean   @default(true)
  startAt     DateTime  @default(now())
  endAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Nội dung trang chủ - key-value cho hero image, intro image, stats...
model HomepageSection {
  id       String  @id @default(cuid())
  key      String  @unique
  value    String
  type     String  @default("text")
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Câu hỏi thường gặp - quản lý FAQ từ admin (song ngữ)
model FaqItem {
  id         String  @id @default(cuid())
  questionVi String
  answerVi   String
  questionEn String  @default("")
  answerEn   String  @default("")
  target     String  @default("GENERAL")
  order      Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Ảnh gallery - quản lý từ admin
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  type      String   @default("common")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@schema("public")
}

/// Liên kết ngoài - hiển thị ở footer, quản lý từ admin
model ExternalLink {
  id       String  @id @default(cuid())
  label    String
  url      String
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                    MEMBERS & AUTH                            ║
// ╚══════════════════════════════════════════════════════════════╝

/// Thành viên CLB - liên kết với Supabase Auth qua authId
/// Hỗ trợ đăng nhập: Google, GitHub, Discord, Email/Password
/// GitHub và Discord có field riêng để xác thực, socials JSON chỉ chứa mạng xã hội khác
model Member {
  id           String    @id
  email        String    @unique
  firstName    String
  middleName   String?
  lastName     String
  avatar       String?
  coverImage   String?
  slug         String?   @unique
  dob          DateTime?
  showDob      Boolean   @default(true)
  showPhone    Boolean   @default(true)
  showStudentId Boolean   @default(true)
  bio          String?
  phone        String?
  studentId    String?
  socials      Json?     @default("{}") // {"facebook":"...","youtube":"...","linkedin":"..."}
  joinedClubAt DateTime?
  leftClubAt   DateTime?
  webRole      WebRole   @default(GUEST)
  isActive     Boolean   @default(true)
  spotifyUri   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  clubRoles             ClubRole[]
  authoredPosts         Post[]                  @relation("PostAuthor")
  reviewedPosts         Post[]                  @relation("PostReviewer")
  postRevisions         PostRevision[]
  eventOrganizerEntries PostOrganizer[]
  achievementEntries    PostAchievementMember[]
  projects              ProjectMember[]
  notifications         Notification[]

  @@index([webRole])
  @@index([isActive])
  @@index([slug])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                    CLUB STRUCTURE                            ║
// ╚══════════════════════════════════════════════════════════════╝

/// Ban / Phòng trong CLB
model Department {
  id   String @id @default(cuid())
  slug String @unique

  nameVi        String  @default("")
  descriptionVi String?
  missionsVi    String  @default("")
  linkLabelVi   String?

  nameEn        String  @default("")
  descriptionEn String?
  missionsEn    String  @default("")
  linkLabelEn   String?

  hyperlink String?
  icon      String?
  bgImage   String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  clubRoles ClubRole[]

  @@schema("public")
}

/// Vai trò / Chức vụ của thành viên trong CLB (lịch sử chức vụ)
model ClubRole {
  id           String       @id @default(cuid())
  memberId     String
  departmentId String?
  position     ClubPosition
  term         Int?
  note         String?
  startAt      DateTime
  endAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([departmentId])
  @@index([position])
  @@index([startAt])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                 UNIFIED POSTS (BLOG / EVENT / ACHIEVEMENT)  ║
// ╚══════════════════════════════════════════════════════════════╝

/// Danh mục bài viết - chỉ áp dụng cho Post type=BLOG
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  color       String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  posts Post[]

  @@schema("public")
}

/// Thẻ tag - dùng chung cho tất cả loại bài viết
model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())

  // --- Relations ---
  posts PostTag[]

  @@schema("public")
}

/// Bài viết thống nhất - gộp Post, Event, Achievement cũ
///
/// Workflow theo type:
///   BLOG: Member tạo -> PENDING_REVIEW -> Admin duyệt -> PUBLISHED
///         Admin/COLLABORATOR tạo -> PUBLISHED (tự động)
///   EVENT: Chỉ ADMIN/COLLABORATOR -> PUBLISHED
///   ACHIEVEMENT: Chỉ ADMIN/COLLABORATOR -> PUBLISHED
///
/// Song ngữ: Khi soạn thảo chọn sourceLanguage, sau đó dùng tool dịch
/// tự động để điền bản còn lại. Cả 2 bản cùng lưu trong 1 record.
model Post {
  id   String   @id @default(cuid())
  type PostType @default(BLOG)

  // -- Nội dung song ngữ --
  titleVi        String
  titleEn        String       @default("")
  slug           String       @unique
  summaryVi      String?
  summaryEn      String?
  contentVi      String
  contentEn      String       @default("")
  sourceLanguage PostLanguage @default(VI)

  // -- Media --
  thumbnail String?
  images    String[] @default([])

  // -- Metadata chung --
  status     PostStatus @default(DRAFT)
  isPinned   Boolean    @default(false)
  viewCount  Int        @default(0)
  authorId   String?
  reviewerId String?
  categoryId String?
  activityId String?

  // -- EVENT-specific fields (nullable) --
  eventStatus  EventStatus?
  eventType    EventType?
  locationVi   String?
  locationEn   String?
  latitude     Float?
  longitude    Float?
  maxAttendees Int?
  startAt      DateTime?
  endAt        DateTime?

  // -- ACHIEVEMENT-specific fields (nullable) --
  achievementType AchievementType?
  achievementDate DateTime?
  isHighlight     Boolean          @default(false)
  relatedUrl      String?

  // -- Timestamps --
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // -- Relations --
  author             Member?                 @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer           Member?                 @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  activity           Activity?               @relation(fields: [activityId], references: [id], onDelete: SetNull)
  tags               PostTag[]
  revisions          PostRevision[]
  activities         PostActivity[]
  organizers         PostOrganizer[]
  sponsorships       PostSponsorship[]
  gallery            Image[]
  achievementMembers PostAchievementMember[]
  notifications      Notification[]

  @@index([type])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([activityId])
  @@schema("public")
}

/// Lịch sử chỉnh sửa bài viết - mỗi lần sửa lưu 1 bản snapshot
model PostRevision {
  id       String @id @default(cuid())
  postId   String
  editorId String?

  titleVi   String
  titleEn   String  @default("")
  summaryVi String?
  summaryEn String?
  contentVi String
  contentEn String  @default("")
  editNote  String?

  createdAt DateTime @default(now())

  // --- Relations ---
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor Member? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([editorId])
  @@schema("public")
}

/// Bảng trung gian: Post <-> Tag (many-to-many)
model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@schema("public")
}

/// Bảng trung gian: Post (type=EVENT) <-> Activity
model PostActivity {
  postId     String
  activityId String

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([postId, activityId])
  @@schema("public")
}

/// Ban tổ chức sự kiện (chỉ dùng cho Post type=EVENT)
model PostOrganizer {
  id       String @id @default(cuid())
  postId   String
  memberId String
  role     String

  createdAt DateTime @default(now())

  // --- Relations ---
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@schema("public")
}

model Image {
  id        String   @id @default(cuid())
  postId    String?
  url       String   @unique
  title     String?
  caption   String?
  isTemp    Boolean  @default(false)
  type      String   @default("ADDITIONAL") // "THUMBNAIL" | "CONTENT" | "MEMBER" | "ADDITIONAL"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([isTemp])
  @@schema("public")
}

/// Thành viên được tuyên dương trong bài ACHIEVEMENT
/// Dùng để đếm số thành tựu trên profile (COUNT theo memberId)
model PostAchievementMember {
  id       String  @id @default(cuid())
  postId   String
  memberId String
  role     String?
  prize    String?
  imageUrl String?

  createdAt DateTime @default(now())

  // --- Relations ---
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                     ACTIVITIES                              ║
// ╚══════════════════════════════════════════════════════════════╝

/// Hoạt động CLB - các chương trình/hoạt động định kỳ
model Activity {
  id   String @id @default(cuid())
  slug String @unique

  titleVi       String
  titleEn       String  @default("")
  descriptionVi String  @default("")
  descriptionEn String  @default("")
  frequencyVi   String?
  frequencyEn   String?

  hyperlink String?
  thumbnail String?
  images    String[] @default([])

  isInternal Boolean @default(false)
  isActive   Boolean @default(true)
  order      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  eventPosts PostActivity[]
  posts      Post[]
  sponsors   Sponsor[]

  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                  SPONSORS & PARTNERS                        ║
// ╚══════════════════════════════════════════════════════════════╝

/// Nhà tài trợ / Đối tác
model Sponsor {
  id            String    @id @default(cuid())
  name          String
  nameEn        String    @default("")
  slug          String    @unique
  descriptionVi String?
  descriptionEn String?
  logo          String?
  email         String?
  phone         String?
  website       String?
  activityId    String?
  startAt       DateTime?
  endAt         DateTime?
  images        String[]  @default([])
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  activity     Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  sponsorships PostSponsorship[]

  @@index([activityId])
  @@schema("public")
}

/// Chi tiết tài trợ - liên kết Sponsor với Post (type=EVENT) hoặc CLB
model PostSponsorship {
  id        String  @id @default(cuid())
  sponsorId String
  postId    String?

  title   String?
  content String?
  tier    String?
  amount  Decimal?

  startAt DateTime
  endAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  post    Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([sponsorId])
  @@index([postId])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                        PROJECTS                             ║
// ╚══════════════════════════════════════════════════════════════╝

/// Dự án CLB
model Project {
  id            String    @id @default(cuid())
  title         String
  titleEn       String    @default("")
  slug          String    @unique
  description   String?
  descriptionEn String?
  content       String?
  contentEn     String    @default("")
  thumbnail     String?
  images        String[]  @default([])
  githubUrl     String?
  websiteUrl    String?
  videoUrl      String?
  technologies  Json      @default("[]")
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  members ProjectMember[]

  @@schema("public")
}

/// Thành viên tham gia dự án
model ProjectMember {
  projectId String
  memberId  String
  role      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                      NOTIFICATIONS                          ║
// ╚══════════════════════════════════════════════════════════════╝

/// Hệ thống thông báo cá nhân
/// Hỗ trợ real-time qua Supabase Realtime (subscription vào bảng này)
model Notification {
  id       String           @id @default(cuid())
  memberId String
  type     NotificationType
  title    String
  content  String?
  linkUrl  String?
  isRead   Boolean          @default(false)
  postId   String?

  createdAt DateTime @default(now())

  // --- Relations ---
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post   Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([memberId, isRead])
  @@index([createdAt])
  @@schema("public")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                      YEAR RECAP                             ║
// ╚══════════════════════════════════════════════════════════════╝

/// Tổng kết hoạt động CLB theo năm
model YearRecap {
  year        Int     @id
  name        String
  description String?
  coverImage  String?
  coverImage2 String?
  coverImage3 String?
  endImage    String?
  musicUrl    String?
  data        Json?   @default("{}")
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}
