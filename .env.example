NEXT_PUBLIC_API_URL=http://localhost:3000

# https://supabase.com/docs/guides/auth/server-side/nextjs
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# https://supabase.com/docs/guides/database/prisma
# DATABASE_URL: Connection pooler (port 6543) - used for runtime queries
# DIRECT_URL: Direct connection (port 5432) - used for migrations
DATABASE_URL=
DIRECT_URL=

ADMIN_ACCOUNT="[admin@example.com]"

# Deepseek API Configuration
DEEPSEEK_API_KEY="your_api_key"

# SSO / OIDC Configuration
# NEXT_PUBLIC_SITE_URL is used to generate the OIDC Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SSO_ISSUER=https://auth.mpclub.dev

# SEO — set these in PRODUCTION only.
# NEXT_PUBLIC_SEO_SITE_URL overrides the canonical/OG/sitemap origin. If unset,
# a localhost NEXT_PUBLIC_SITE_URL is ignored and https://mpclub.dev is used.
# NEXT_PUBLIC_SEO_SITE_URL=https://mpclub.dev
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<token from Google Search Console>
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SERVICE_API_KEY=
SSO_ADMIN_SECRET=
SESSION_SECRET=
CRON_SECRET=
